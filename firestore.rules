rules_version = '2';

// RNF05: cada usuário só lê e escreve os próprios dados.
// Estrutura: docs/arquitetura/modelo-de-dados.md
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Documento do usuário e tudo abaixo dele (rotina, tarefas, plano, preferências).
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // Qualquer outro caminho é negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
