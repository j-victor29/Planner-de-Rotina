# Copie este arquivo para .env.local e preencha com os dados do projeto no Firebase.
# Firebase Console > Configurações do projeto > Seus apps > SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "mock" = dados em memória (etapa 2) | "firebase" = Firebase real (etapa 3)
VITE_DATA_SOURCE=mock

# true = conecta aos emuladores locais do Firebase (testes de integração)
VITE_USE_FIREBASE_EMULATORS=false
